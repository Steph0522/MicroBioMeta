pkgVer <- function(pkg) {
    if (!exists("meta") || is.null(meta)) meta <- packageDescription(pkg)
    ver <- meta$Version
    paste0('https://github.com/Steph0522/MicroBioMeta/', pkg, ' - R package version ', ver)
}

bibentry(
    bibtype = "manual",
    title   = "MicroBioMeta: Analysis and Visualization of Microbiome Diversity, Composition, and Differential Abundance",
    author  = c(
        person("Stephanie", "Hereira Pacheco"),
        person("Nina", "Montoya Ciriaco"),
        person("Karla", "Zarco Gonzalez")
    ),
    year    = format(Sys.Date(), "%Y"),
    url     = "http://www.bioconductor.org/packages/MicroBioMeta",
    note    = pkgVer('MicroBioMeta'),
    doi     = '10.18129/B9.bioc.MicroBioMeta'
)
